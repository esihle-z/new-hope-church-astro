---
// LifeAtTheNext.astro
// Photo gallery grid showcasing life at the church.
// Background: warm beige (#efe8d7), mixed row-span grid.
---

<section id="life-at-the-next" class="bg-[#efe8d7] py-20 md:py-28 px-6 md:px-16 animate-fade-up">
  <div class="max-w-6xl mx-auto">
    <!-- Header -->
    <div class="flex items-end justify-between mb-8">
      <h2 class="font-serif italic text-3xl md:text-4xl text-[#111111] leading-snug">
        Life at The Next.
      </h2>
      <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-[#111111]/40">
        Photography only &middot; no copy
      </span>
    </div>

    <!-- Photo grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4">
      <!-- Image 1: tall (row-span-2) -->
      <div
        class="row-span-2 rounded-2xl flex items-center justify-center min-h-[200px] md:min-h-[400px] shadow-[0_2px_16px_rgba(0,0,0,0.04)]"
        style="background: repeating-linear-gradient(135deg, #ddd6c2 0 8px, #e9e2cf 8px 16px);"
      >
        <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-[#111111]/40">
          Photo 1
        </span>
      </div>

      <!-- Image 2: normal -->
      <div
        class="rounded-2xl flex items-center justify-center min-h-[100px] md:min-h-[190px] shadow-[0_2px_16px_rgba(0,0,0,0.04)]"
        style="background: repeating-linear-gradient(135deg, #ddd6c2 0 8px, #e9e2cf 8px 16px);"
      >
        <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-[#111111]/40">
          Photo 2
        </span>
      </div>

      <!-- Image 3: normal -->
      <div
        class="rounded-2xl flex items-center justify-center min-h-[100px] md:min-h-[190px] shadow-[0_2px_16px_rgba(0,0,0,0.04)]"
        style="background: repeating-linear-gradient(135deg, #ddd6c2 0 8px, #e9e2cf 8px 16px);"
      >
        <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-[#111111]/40">
          Photo 3
        </span>
      </div>

      <!-- Image 4: normal -->
      <div
        class="rounded-2xl flex items-center justify-center min-h-[100px] md:min-h-[190px] shadow-[0_2px_16px_rgba(0,0,0,0.04)]"
        style="background: repeating-linear-gradient(135deg, #ddd6c2 0 8px, #e9e2cf 8px 16px);"
      >
        <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-[#111111]/40">
          Photo 4
        </span>
      </div>

      <!-- Image 5: normal -->
      <div
        class="rounded-2xl flex items-center justify-center min-h-[100px] md:min-h-[190px] shadow-[0_2px_16px_rgba(0,0,0,0.04)]"
        style="background: repeating-linear-gradient(135deg, #ddd6c2 0 8px, #e9e2cf 8px 16px);"
      >
        <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-[#111111]/40">
          Photo 5
        </span>
      </div>

      <!-- Image 6: tall (row-span-2) -->
      <div
        class="row-span-2 rounded-2xl flex items-center justify-center min-h-[200px] md:min-h-[400px] shadow-[0_2px_16px_rgba(0,0,0,0.04)]"
        style="background: repeating-linear-gradient(135deg, #ddd6c2 0 8px, #e9e2cf 8px 16px);"
      >
        <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-[#111111]/40">
          Photo 6
        </span>
      </div>

      <!-- Image 7: normal -->
      <div
        class="rounded-2xl flex items-center justify-center min-h-[100px] md:min-h-[190px] shadow-[0_2px_16px_rgba(0,0,0,0.04)]"
