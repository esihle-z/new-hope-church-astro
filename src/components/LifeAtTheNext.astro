      >
        <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-[#111111]/40">
          Photo 7
        </span>
      </div>

      <!-- Image 8: normal -->
      <div
        class="rounded-2xl flex items-center justify-center min-h-[100px] md:min-h-[190px] shadow-[0_2px_16px_rgba(0,0,0,0.04)]"
        style="background: repeating-linear-gradient(135deg, #ddd6c2 0 8px, #e9e2cf 8px 16px);"
      >
        <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-[#111111]/40">
          Photo 8
        </span>
      </div>
    </div>
  </div>
</section>
