---
// LifeAtTheNext.astro
// Photo gallery grid showcasing life at the church.
// Background: warm beige (#efe8d7), mixed row-span grid.
---

<section id="life-at-the-next" class="bg-[#efe8d7] py-20 md:py-28 px-6 md:px-16 animate-fade-up">
  <div class="max-w-6xl mx-auto">
    <!-- Header -->
    <div class="flex items-end justify-between mb-8">
      <h2 class="font-serif italic text-3xl md:text-4xl text-[#111111] leading-snug">
        Life at The Next.
      </h2>
      <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-[#111111]/40">
        Photography only &middot; no copy
      </span>
    </div>

    <!-- Photo grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4">
      <!-- Image 1: tall (row-span-2) -->
      <img
        src="/photos/TheNextChurch-126.jpg"
        alt="Life at The Next"
        loading="lazy"
        class="row-span-2 w-full h-full object-cover rounded-2xl min-h-[200px] md:min-h-[400px] shadow-[0_2px_16px_rgba(0,0,0,0.04)]"
      />

      <!-- Image 2: normal -->
      <img
        src="/photos/TheNextChurch-132.jpg"
        alt="Life at The Next"
        loading="lazy"
        class="w-full h-full object-cover rounded-2xl min-h-[100px] md:min-h-[190px] shadow-[0_2px_16px_rgba(0,0,0,0.04)]"
      />

      <!-- Image 3: normal -->
      <img
        src="/photos/DSC05603.jpg"
        alt="Life at The Next"
        loading="lazy"
        class="w-full h-full object-cover rounded-2xl min-h-[100px] md:min-h-[190px] shadow-[0_2px_16px_rgba(0,0,0,0.04)]"
      />

      <!-- Image 4: normal -->
      <img
        src="/photos/TheNextChurch-012.jpg"
        alt="Life at The Next"
        loading="lazy"
        class="w-full h-full object-cover rounded-2xl min-h-[100px] md:min-h-[190px] shadow-[0_2px_16px_rgba(0,0,0,0.04)]"
      />

      <!-- Image 5: normal -->
      <img
        src="/photos/DSC05438.jpg"
        alt="Life at The Next"
        loading="lazy"
        class="w-full h-full object-cover rounded-2xl min-h-[100px] md:min-h-[190px] shadow-[0_2px_16px_rgba(0,0,0,0.04)]"
      />

      <!-- Image 6: tall (row-span-2) -->
      <img
        src="/photos/TheNextChurch-074.jpg"
        alt="Life at The Next"
        loading="lazy"
        class="row-span-2 w-full h-full object-cover rounded-2xl min-h-[200px] md:min-h-[400px] shadow-[0_2px_16px_rgba(0,0,0,0.04)]"
      />

      <!-- Image 7: normal -->
      <img
        src="/photos/DSC04819.jpg"
        alt="Life at The Next"
        loading="lazy"
        class="w-full h-full object-cover rounded-2xl min-h-[100px] md:min-h-[190px] shadow-[0_2px_16px_rgba(0,0,0,0.04)]"
      />

      <!-- Image 8: normal -->
      <img
        src="/photos/DSC05481.jpg"
        alt="Life at The Next"
        loading="lazy"
        class="w-full h-full object-cover rounded-2xl min-h-[100px] md:min-h-[190px] shadow-[0_2px_16px_rgba(0,0,0,0.04)]"
      />
    </div>
  </div>
</section>
